# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave both Supabase vars empty to run in "local mode" (data saved in the browser, no login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shown on the pricing page
NEXT_PUBLIC_PRO_PRICE_LABEL=$5/month

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Card data source (optcgapi.com-compatible JSON). Responses are cached for 24h.
CARD_API_URL=https://optcgapi.com/api/allSetCards/
CARD_API_ST_URL=https://optcgapi.com/api/allSTCards/
